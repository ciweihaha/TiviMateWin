<Window x:Class="TiviMateWin.ChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="频道" Width="480" Height="270" MinWidth="320" MinHeight="180"
        WindowStartupLocation="CenterOwner" Background="#FF12161B" Foreground="#FFE8EDF2"
        FontFamily="Microsoft YaHei UI" Closing="Window_Closing" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <lvc:VideoView x:Name="VideoView" Grid.Row="0" Background="Black" Focusable="False"/>
        <Border Grid.Row="1" Background="#FF191F26" BorderBrush="#FF272E37" BorderThickness="0,1,0,0" Padding="10,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="＋" Width="28" Height="24" Margin="4,0,0,0" Click="BtnVolUp_Click"
                            Background="#FF232B34" Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="－" Width="28" Height="24" Margin="4,0,0,0" Click="BtnVolDown_Click"
                            Background="#FF232B34" Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Text="" Foreground="#FFB9C4CE" FontSize="13"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>