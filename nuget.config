<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NuGet 源顺序说明（本次仅加注释，未调整顺序）：腾讯镜像置于 nuget.org 之前，优先走国内镜像、失败时回落 nuget.org；该顺序为既有配置，无实测证据表明应调整，故不改动。 -->
  <packageSources>
    <clear />
    <add key="tencent" value="https://mirrors.cloud.tencent.com/nuget/" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
