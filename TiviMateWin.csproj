<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 应用图标：exe 文件图标（任务栏/桌面快捷方式/资源管理器） -->
    <ApplicationIcon>Assets\tivimate-icon.ico</ApplicationIcon>
    <Version>1.4.18</Version>
    <!-- F9：1.4.18 仅为本地构建回退版本；tag 构建由 CI 在 Publish 时以 -p:Version 注入（见 .github/workflows/build.yml）。 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Optimize>true</Optimize>
    <!-- 发布体积：不带调试器支持文件（mscordaccore 等，仅影响调试/转储分析，不影响正常运行） -->
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <!-- 窗口图标：供 MainWindow/PipWindow 的 Icon 属性引用（pack URI 资源） -->
  <ItemGroup>
    <Resource Include="Assets\tivimate-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

  <!-- 主题资源字典：不作为 Page 编译进程序集，而是作为 Content 复制到输出目录，运行时按相对路径加载 -->
  <ItemGroup>
    <Page Remove="Themes\*.xaml" />
    <None Remove="Themes\*.xaml" />
    <Content Include="Themes\*.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 性能优化：删除非本机架构的 VLC 原生库与无用的 Web 远程接口 -->
  <!-- 播放专用裁剪（2026-11-14）：本应用只做播放，不用 sout/转码/录制/可视化/服务发现/元数据抓取，
       也不用字幕叠加滤镜与语音朗读；另删蓝光/数字影院/CD/电视调谐器/SFTP 等用不到的接入插件
       （本应用只播 http(s) 链接与本地文件）。经代码核查，无任何 sout、录制、Media.Parse、发现相关调用，
       LibVLC 仅传 no-osd 与 avcodec-hw 两个参数。以下插件目录在播放路径上永不加载，删除只减小体积；
       字幕仍由 text_renderer/freetype 渲染。另删除链接期 .lib（运行时无用）。改动后须经 playtest
       真流验证，并在真机上抽查字幕显示。 -->
  <Target Name="TrimVlcArchitectures" AfterTargets="Build">
    <ItemGroup>
      <VlcRemoveFiles Include="$(OutDir)libvlc\win-x86\**\*;$(OutDir)libvlc\win-arm64\**\*;$(OutDir)libvlc\win-x64\lua\http\**\*;$(OutDir)libvlc\win-x64\hrtfs\**\*;$(OutDir)libvlc\win-x64\plugins\access_output\**\*;$(OutDir)libvlc\win-x64\plugins\stream_out\**\*;$(OutDir)libvlc\win-x64\plugins\mux\**\*;$(OutDir)libvlc\win-x64\plugins\visualization\**\*;$(OutDir)libvlc\win-x64\plugins\services_discovery\**\*;$(OutDir)libvlc\win-x64\plugins\meta_engine\**\*;$(OutDir)libvlc\win-x64\plugins\spu\**\*;$(OutDir)libvlc\win-x64\plugins\text_renderer\libsapi_plugin.dll;$(OutDir)libvlc\win-x64\plugins\stream_filter\librecord_plugin.dll;$(OutDir)libvlc\win-x64\*.lib;$(OutDir)libvlc\win-x64\plugins\access\liblibbluray_plugin.dll;$(OutDir)libvlc\win-x64\plugins\access\libbluray-j2se-1.4.1.jar;$(OutDir)libvlc\win-x64\plugins\access\libbluray-awt-j2se-1.4.1.jar;$(OutDir)libvlc\win-x64\plugins\access\libdcp_plugin.dll;$(OutDir)libvlc\win-x64\plugins\access\libcdda_plugin.dll;$(OutDir)libvlc\win-x64\plugins\access\libdtv_plugin.dll;$(OutDir)libvlc\win-x64\plugins\access\libsftp_plugin.dll" />
    </ItemGroup>
    <Delete Files="@(VlcRemoveFiles)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutDir)libvlc\win-x86;$(OutDir)libvlc\win-arm64;$(OutDir)libvlc\win-x64\lua\http;$(OutDir)libvlc\win-x64\hrtfs;$(OutDir)libvlc\win-x64\plugins\access_output;$(OutDir)libvlc\win-x64\plugins\stream_out;$(OutDir)libvlc\win-x64\plugins\mux;$(OutDir)libvlc\win-x64\plugins\visualization;$(OutDir)libvlc\win-x64\plugins\services_discovery;$(OutDir)libvlc\win-x64\plugins\meta_engine;$(OutDir)libvlc\win-x64\plugins\spu" ContinueOnError="true" />
  </Target>

  <!-- publish 流程中 NuGet 原生文件直接从包复制到发布目录，需单独裁剪（与 Build 目标保持同一裁剪集） -->
  <Target Name="TrimVlcArchitecturesPublish" AfterTargets="Publish">
    <ItemGroup>
      <VlcPubRemove Include="$(PublishDir)libvlc\win-x86\**\*;$(PublishDir)libvlc\win-arm64\**\*;$(PublishDir)libvlc\win-x64\lua\http\**\*;$(PublishDir)libvlc\win-x64\hrtfs\**\*;$(PublishDir)libvlc\win-x64\plugins\access_output\**\*;$(PublishDir)libvlc\win-x64\plugins\stream_out\**\*;$(PublishDir)libvlc\win-x64\plugins\mux\**\*;$(PublishDir)libvlc\win-x64\plugins\visualization\**\*;$(PublishDir)libvlc\win-x64\plugins\services_discovery\**\*;$(PublishDir)libvlc\win-x64\plugins\meta_engine\**\*;$(PublishDir)libvlc\win-x64\plugins\spu\**\*;$(PublishDir)libvlc\win-x64\plugins\text_renderer\libsapi_plugin.dll;$(PublishDir)libvlc\win-x64\plugins\stream_filter\librecord_plugin.dll;$(PublishDir)libvlc\win-x64\*.lib;$(PublishDir)libvlc\win-x64\plugins\access\liblibbluray_plugin.dll;$(PublishDir)libvlc\win-x64\plugins\access\libbluray-j2se-1.4.1.jar;$(PublishDir)libvlc\win-x64\plugins\access\libbluray-awt-j2se-1.4.1.jar;$(PublishDir)libvlc\win-x64\plugins\access\libdcp_plugin.dll;$(PublishDir)libvlc\win-x64\plugins\access\libcdda_plugin.dll;$(PublishDir)libvlc\win-x64\plugins\access\libdtv_plugin.dll;$(PublishDir)libvlc\win-x64\plugins\access\libsftp_plugin.dll" />
    </ItemGroup>
    <Delete Files="@(VlcPubRemove)" ContinueOnError="true" />
    <RemoveDir Directories="$(PublishDir)libvlc\win-x86;$(PublishDir)libvlc\win-arm64;$(PublishDir)libvlc\win-x64\lua\http;$(PublishDir)libvlc\win-x64\hrtfs;$(PublishDir)libvlc\win-x64\plugins\access_output;$(PublishDir)libvlc\win-x64\plugins\stream_out;$(PublishDir)libvlc\win-x64\plugins\mux;$(PublishDir)libvlc\win-x64\plugins\visualization;$(PublishDir)libvlc\win-x64\plugins\services_discovery;$(PublishDir)libvlc\win-x64\plugins\meta_engine;$(PublishDir)libvlc\win-x64\plugins\spu" ContinueOnError="true" />
  </Target>

</Project>
