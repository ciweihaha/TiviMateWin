<Window x:Class="TiviMateWin.PipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="小窗" Width="320" Height="180" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" Topmost="True" Background="#FF000000"
        WindowStartupLocation="Manual" Closed="Window_Closed">
    <Grid>
        <lvc:VideoView x:Name="VideoView" Background="Black" Focusable="False"/>
        <!-- 标题栏：可拖动 -->
        <Border x:Name="TitleBar" Height="24" VerticalAlignment="Top" Background="#CC000000"
                MouseLeftButtonDown="TitleBar_MouseDown" MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseUp">
            <DockPanel>
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Width="24" Height="24" Background="Transparent"
                        BorderThickness="0" Foreground="#FFE2E8EF" FontSize="12" Cursor="Hand"
                        Click="Close_Click" Content="✕" Focusable="False"/>
                <TextBlock x:Name="TitleText" Text="小窗" Foreground="#FFE2E8EF" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>