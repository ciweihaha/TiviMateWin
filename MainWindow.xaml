<Window x:Class="TiviMateWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="星辰直播" Height="640" Width="1120" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="Assets/tivimate-icon.ico"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ItemFgBrush}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchHint" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 深色进度条模板：轨道始终可见（左侧蓝=已播放，右侧深灰=未播放），滑块为圆点 -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Height="6" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource SliderFillBrush}"
                                              Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="{DynamicResource SliderTrackBrush}"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource SliderFillBrush}"
                                                         Stroke="{DynamicResource SliderThumbStrokeBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideCol" Width="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧栏边缘收起/展开按钮：点击缩进到最左（视频区占满），再点展开 -->
        <!-- 深查第 17 轮：箭头须跟随代码三处 SetValue(TextBlock.TextProperty) 变化——
             旧模板把 Text 写死为 "◀"、没有任何绑定，收起后箭头永远不变。改为绑定到
             模板化父级（即按钮本身）上该依赖属性的值；TextBlock.Text 不是附加属性，
             不能在 XAML 里以属性形式给按钮设初值，初值用 TargetNullValue 兜底。 -->
        <Button x:Name="SideToggleBtn" Grid.Column="1" Width="12" Background="{DynamicResource SideBgBrush}"
                BorderThickness="0" Cursor="Hand" Click="SideToggle_Click"
                ToolTip="收起/展开侧栏（Tab）" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <TextBlock x:Name="Txt" Text="{Binding Path=(TextBlock.Text), RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=◀}" Foreground="{DynamicResource MutedFgBrush}" FontSize="9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- 左侧栏 -->
        <Border Grid.Column="0" Background="{DynamicResource SideBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock Text="直播列表" DockPanel.Dock="Top" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="14,14,12,10"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,12,10">
                    <Button Style="{StaticResource ToolBtn}" Content="添加源" Click="BtnAdd_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="刷新" Click="BtnRefresh_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="收藏" Click="BtnFav_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="小窗" Click="BtnPip_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="全屏" Click="BtnFull_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="节目表" Click="BtnGuide_Click"
                            ToolTip="打开节目表（时间轴）"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,12,10">
                    <Button Style="{StaticResource ToolBtn}" Content="网盘" Click="BtnCloud_Click"
                            ToolTip="浏览 OpenList 网盘里的视频并播放"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                    <TextBox x:Name="SearchBox" Height="30" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1" Foreground="{DynamicResource InputFgBrush}" Padding="8,4" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                             ToolTip="Ctrl+F 聚焦搜索，Esc 清空，回车播放第一个结果"/>
                    <TextBlock Text="搜索频道 / 分组（Ctrl+F）" Style="{StaticResource SearchHint}"
                               Foreground="{DynamicResource MutedFgBrush}" FontSize="12" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <!-- 独立源管理面板：可展开/收起，显示所有源并点击切换 -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,8" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <Button x:Name="SrcToggleBtn" DockPanel.Dock="Right" Width="30" Height="30"
                                Content="▾" Foreground="{DynamicResource BtnFgBrush}" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="SrcToggle_Click" ToolTip="展开/收起源列表"/>
                        <TextBlock Text="源列表" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SrcPanel, Path=Visibility}" Value="Visible">
                                    <Setter Property="Padding" Value="0,0,0,6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel x:Name="SrcPanel" DockPanel.Dock="Top" Margin="12,0,12,8" Visibility="Collapsed">
                    <ListBox x:Name="SrcList" MaxHeight="160" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1" SelectionChanged="SrcList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="6,3">
                                    <!-- 深查第 24 轮：旧模板给每行都画 ●，当前源标记失去意义；
                                         改为仅选中行（即当前激活源，见 RefreshPlaylistCombo）显示。 -->
                                    <TextBlock Text="●" Foreground="{DynamicResource AccentBrush}" FontSize="10"
                                               VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ItemFgBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="管理源…" Height="28" Margin="0,6,0,0" Background="{DynamicResource BtnBgBrush}"
                            Foreground="{DynamicResource BtnFgBrush}" BorderThickness="0" Cursor="Hand" FontSize="12"
                            Click="BtnAdd_Click"/>
                </StackPanel>

                <DockPanel DockPanel.Dock="Top" Margin="12,0,12,8">
                    <Button DockPanel.Dock="Right" Content="管理" Width="44" Height="30" Margin="6,0,0,0"
                            Background="{DynamicResource BtnBgBrush}" Foreground="{DynamicResource BtnFgBrush}" BorderThickness="0" Cursor="Hand"
                            FontSize="11" Click="BtnManageGroups_Click" ToolTip="分组管理"/>
                    <ComboBox x:Name="GroupCombo" Height="30" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource InputFgBrush}"
                              SelectionChanged="GroupCombo_SelectionChanged"/>
                </DockPanel>

                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Text="0 个频道"
                           Foreground="{DynamicResource MutedFgBrush}" FontSize="12" Margin="14,2,12,6"/>

                <Grid Margin="4,0,4,6">
                    <ListBox x:Name="ChannelList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizing="True"
                             MouseDoubleClick="ChannelList_MouseDoubleClick">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="小窗播放" Click="MiPip_Click"/>
                            <MenuItem Header="新窗口播放" Click="MiNewWin_Click"/>
                            <MenuItem Header="收藏 / 取消收藏" Click="MiFavorite_Click"/>
                            <MenuItem Header="隐藏频道" Click="MiHide_Click"/>
                            <MenuItem Header="复制频道地址" Click="MiCopy_Click"/>
                            <Separator/>
                            <!-- 2026-11-05 第 2 轮：排序由二级子菜单拍平为一级菜单项，少一次悬停展开；
                                 名称、勾选态、点击处理均不变，不改排序逻辑、不改分组逻辑。 -->
                            <MenuItem x:Name="SortByNumber" Header="按号码" IsCheckable="True" IsChecked="True"
                                      Click="SortByNumber_Click"/>
                            <MenuItem x:Name="SortByName" Header="按名称" IsCheckable="True"
                                      Click="SortByName_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- UI 改版：双行频道行（约 44px）——第一行频道名，第二行当前节目 + 细进度条；
                                 频道号、台标、收藏星、播放中指示条全部保留。 -->
                            <Grid Margin="8,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 播放中指示条（V1.4）：当前频道左侧蓝色竖条 -->
                                <Border Width="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"
                                        Margin="-6,0,7,0" VerticalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- 频道 Logo（V1.4）：异步加载 + 磁盘缓存；无 Logo 时显示首字符占位。
                                     结构保持 Grid[Border 占位, Image]：LoadLogoInto 按 Children[0] 找占位。 -->
                                <Grid Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border x:Name="LogoFallback" CornerRadius="6" Background="#26808FA0">
                                        <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource ItemFgBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image x:Name="LogoImg" Width="32" Height="32" Stretch="Uniform" Loaded="LogoImg_Loaded"/>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding Number}" Width="34" Foreground="{DynamicResource NumberFgBrush}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="0">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Group}" Foreground="{DynamicResource ItemSubFgBrush}" FontSize="11"
                                                   VerticalAlignment="Center" MaxWidth="80" Margin="6,0,0,0"
                                                   TextTrimming="CharacterEllipsis" DockPanel.Dock="Right" ToolTip="{Binding Group}"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ItemFgBrush}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding NowProgramText}" Foreground="{DynamicResource ItemSubFgBrush}" FontSize="11"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding NowProgramText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowProgramText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ProgressBar Height="3" Margin="0,3,0,0" Minimum="0" Maximum="1" Value="{Binding NowProgress}"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowProgress}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                                <Button Grid.Column="4" Content="{Binding FavoriteMark}" Tag="{Binding}" Click="FavStar_Click"
                                        Width="22" Height="22" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource StarBrush}" FontSize="14" Cursor="Hand" Focusable="False"
                                        ToolTip="点击收藏 / 取消收藏" Margin="4,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoMatchText" Grid.Row="0" Text="未找到匹配频道" Foreground="{DynamicResource MutedFgBrush}"
                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            </DockPanel>
        </Border>

        <!-- 视频区 + 状态栏 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <lvc:VideoView x:Name="VideoView" Grid.Row="0" Grid.Column="0" Background="Black" Focusable="False"/>

            <!-- 换台 OSD（V1.4）：频道号 + 名称 + 当前节目，3 秒自动隐藏。
                 UI 改版：由右上角卡片改为底部控制条（频道号 + 台标 + 频道名 + 当前节目 + 节目进度），
                 边距仍按视频区尺寸自适应（见 ShowChannelOsd，电视 overscan 裁边时不被切）。 -->
            <Border x:Name="ChannelOsd" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    Margin="16,0,16,16" Background="#D9151B24" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="16,10" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <TextBlock x:Name="OsdNumber" Text="" FontSize="30" FontWeight="Bold" Foreground="#FF4FA3E3"
                                   VerticalAlignment="Center" MinWidth="40" TextAlignment="Center"/>
                        <!-- OSD 台标：首字符占位 + 异步图（复用 LogoService；无 Logo 时只显示占位） -->
                        <Grid Width="40" Height="40" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Border x:Name="OsdLogoFallback" CornerRadius="6" Background="#26808FA0">
                                <TextBlock x:Name="OsdLogoInitial" Text="" FontSize="16" FontWeight="Bold"
                                           Foreground="#FFE8EDF2"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="OsdLogoImg" Width="40" Height="40" Stretch="Uniform"/>
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="OsdName" Text="" FontSize="17" FontWeight="SemiBold" Foreground="#FFE8EDF2"
                                       MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="OsdEpg" Text="" FontSize="12" Foreground="#FF9FB3C8" Margin="0,2,0,0"
                                       MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 当前节目进度：无节目时隐藏（见 ShowChannelOsd / UpdateProgress） -->
                    <ProgressBar x:Name="OsdProgress" Grid.Row="1" Height="3" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0"
                                 Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- EPG 节目单面板 -->
            <Border x:Name="EpgPanel" Grid.Row="0" Grid.Column="1" Width="260" Background="{DynamicResource EpgBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Text="节目单" DockPanel.Dock="Top" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                               FontSize="13" Margin="12,10,12,6"/>
                    <TextBlock x:Name="EpgNow" DockPanel.Dock="Top" Foreground="{DynamicResource EpgSubFgBrush}" FontSize="11"
                               Margin="12,0,12,8" TextWrapping="Wrap"/>
                    <ListBox x:Name="EpgList" Background="Transparent" BorderThickness="0" Margin="0,0,0,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,4">
                                    <TextBlock Text="{Binding TimeRange}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ItemFgBrush}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel x:Name="EmptyState" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="暂无频道" FontSize="18" Foreground="{DynamicResource EmptyFgBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="添加 M3U / M3U8 播放列表后即可观看" FontSize="12" Foreground="{DynamicResource SubFgBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <Button Content="添加播放列表" Style="{StaticResource ToolBtn}" FontSize="13" Padding="18,8"
                         Margin="0,16,0,0" HorizontalAlignment="Center" Click="BtnAdd_Click"/>
            </StackPanel>

            <!-- 全屏控制浮层：鼠标移动显示，静止自动隐藏。
                 UI 改版：由居中按钮组改为底部控制条（当前节目进度细条 + 频道名/当前节目 + 控制按钮）。 -->
            <Border x:Name="FullscreenOverlay" Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBgBrush}"
                    Visibility="Collapsed" VerticalAlignment="Bottom">
                <Grid Margin="24,10,24,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 当前节目进度：无节目时隐藏（见 ShowFullscreenOverlay / UpdateProgress） -->
                    <ProgressBar x:Name="FsProgress" Grid.Row="0" Height="3" Minimum="0" Maximum="1"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0"
                                 Visibility="Collapsed"/>
                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FsPlayPause" Content="⏸" Width="40" Height="36" Margin="4,0"
                                    Background="{DynamicResource FsBtnBgBrush}" Foreground="{DynamicResource FgBrush}" BorderThickness="0" Cursor="Hand"
                                    Click="BtnPlayPause_Click" ToolTip="播放/暂停（Space）"/>
                            <Button x:Name="FsStop" Content="⏹" Width="40" Height="36" Margin="4,0"
                                    Background="{DynamicResource FsBtnBgBrush}" Foreground="{DynamicResource FgBrush}" BorderThickness="0" Cursor="Hand"
                                    Click="BtnStop_Click" ToolTip="停止（S）"/>
                            <Button x:Name="FsExitFull" Content="退出全屏" Width="88" Height="36" Margin="4,0"
                                    Background="{DynamicResource FsBtnBgBrush}" Foreground="{DynamicResource FgBrush}" BorderThickness="0" Cursor="Hand"
                                    Click="BtnFull_Click" ToolTip="退出全屏（Esc / F11）"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" MinWidth="0">
                            <TextBlock x:Name="FsNowPlaying" Text="" Foreground="{DynamicResource FgBrush}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="FsEpg" Text="" Foreground="{DynamicResource EpgSubFgBrush}" FontSize="12"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 节目表（时间轴）视图：覆盖视频区的浮层，视频在后台继续播放；Esc / 关闭按钮退出。
                 数据复用现有 EPG（_epg / GetPrograms），不改解析；行数上限 200，避免超大源卡死。 -->
            <Grid x:Name="GuideView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                  Visibility="Collapsed" Background="{DynamicResource WindowBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头栏 -->
                <DockPanel Grid.Row="0" Margin="16,12,16,8">
                    <Button Content="关闭" DockPanel.Dock="Right" Style="{StaticResource ToolBtn}" FontSize="12"
                            Padding="12,6" Click="GuideClose_Click" ToolTip="关闭节目表（Esc）"/>
                    <Button Content="回到现在" DockPanel.Dock="Right" Style="{StaticResource ToolBtn}" FontSize="12"
                            Padding="12,6" Click="GuideNow_Click" ToolTip="回到当前时间"/>
                    <TextBlock Text="节目表" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="GuideGroupText" Text="全部" Foreground="{DynamicResource SubFgBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="GuideWindowText" Text="" Foreground="{DynamicResource MutedFgBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>

                <!-- 时间轴 -->
                <Grid Grid.Row="1" Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 频道列：与右侧时间轴纵向同步滚动（见 GuideTimelineScroll_ScrollChanged） -->
                    <Border Grid.Column="0" Background="{DynamicResource SideBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,0" CornerRadius="8,0,0,8">
                        <ScrollViewer x:Name="GuideChannelScroll" VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="GuideChannelList" Margin="0,28,0,0"/>
                        </ScrollViewer>
                    </Border>
                    <!-- 节目时间轴 -->
                    <ScrollViewer x:Name="GuideTimelineScroll" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="GuideTimelineScroll_ScrollChanged">
                        <Grid x:Name="GuideTimelineContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Canvas x:Name="GuideRuler" Grid.Row="0" Height="28"/>
                            <Grid x:Name="GuideRows" Grid.Row="1"/>
                            <!-- 现在竖线：覆盖刻度 + 全部节目行（不拦截节目块点击） -->
                            <Canvas x:Name="GuideNowLineLayer" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                                <Rectangle x:Name="GuideNowLine" Width="2" Fill="{DynamicResource NowLineBrush}"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 节目详情：点节目块后显示；提醒/录制/回放本应用没有对应功能，只显示能做的“看直播”。 -->
                <Border Grid.Row="2" Margin="16,0,16,12" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <Grid>
                        <TextBlock x:Name="GuideDetailEmpty" Text="点击上方节目块查看详情" Foreground="{DynamicResource MutedFgBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <DockPanel x:Name="GuideDetail" Visibility="Collapsed">
                            <Button x:Name="GuideDetailPlay" DockPanel.Dock="Right" Content="看直播" Style="{StaticResource ToolBtn}"
                                    FontSize="13" Padding="16,8" VerticalAlignment="Center" Click="GuideDetailPlay_Click"/>
                            <StackPanel VerticalAlignment="Center" MinWidth="0">
                                <TextBlock x:Name="GuideDetailTitle" Text="" Foreground="{DynamicResource ItemFgBrush}" FontSize="14"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GuideDetailMeta" Text="" Foreground="{DynamicResource SubFgBrush}" FontSize="12"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GuideDetailDesc" Text="" Foreground="{DynamicResource ItemSubFgBrush}" FontSize="12"
                                           Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="StatusBar" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SideBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="14,7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPlayPause" Content="⏸" Width="26" Height="24" Margin="4,0,0,0"
                                Background="{DynamicResource BtnBgBrush}" Foreground="{DynamicResource BtnFgBrush}" BorderThickness="0" Cursor="Hand"
                                Click="BtnPlayPause_Click" ToolTip="播放/暂停（Space）"/>
                        <Button x:Name="BtnStop" Content="⏹" Width="26" Height="24" Margin="4,0,0,0"
                                Background="{DynamicResource BtnBgBrush}" Foreground="{DynamicResource BtnFgBrush}" BorderThickness="0" Cursor="Hand"
                                Click="BtnStop_Click" ToolTip="停止（S）"/>
                        <Button x:Name="BtnSettings" Content="⚙" Width="26" Height="24" Margin="4,0,0,0"
                                Background="{DynamicResource BtnBgBrush}" Foreground="{DynamicResource BtnFgBrush}" BorderThickness="0" Cursor="Hand"
                                Click="BtnSettings_Click" ToolTip="设置"/>
                        <TextBlock x:Name="VolumeText" Text="音量 80%" Foreground="{DynamicResource SubFgBrush}" FontSize="12"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlayState" Text="就绪" Foreground="{DynamicResource SubFgBrush}" FontSize="12"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="NowPlaying" Text="未播放" Foreground="{DynamicResource EpgSubFgBrush}" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               DockPanel.Dock="Left" MaxWidth="280"/>
                    <Grid VerticalAlignment="Center" Margin="14,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeText" Text="00:00" Foreground="{DynamicResource SubFgBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                Style="{StaticResource DarkSlider}"
                                ValueChanged="SeekBar_ValueChanged"
                                PreviewMouseDown="SeekBar_PreviewMouseDown"
                                PreviewMouseUp="SeekBar_PreviewMouseUp"/>
                        <TextBlock x:Name="DurationText" Text="--:--" Grid.Column="2" Foreground="{DynamicResource SubFgBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
