<Window x:Class="TiviMateWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="星辰直播" Height="640" Width="1120" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF12161B" Foreground="#FFE8EDF2"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF232B34"/>
            <Setter Property="Foreground" Value="#FFC7D1DA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF31404F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F4E7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFE2E8EF"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF232B34"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F4E7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchHint" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 深色进度条模板：轨道始终可见（左侧蓝=已播放，右侧深灰=未播放），滑块为圆点 -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Height="6" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="#FF4FA3E3"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="#FF2D3540"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="#FF4FA3E3"
                                                         Stroke="#FFDDE4EB" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideCol" Width="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧栏边缘收起/展开按钮：点击缩进到最左（视频区占满），再点展开 -->
        <Button x:Name="SideToggleBtn" Grid.Column="1" Width="12" Background="#FF191F26"
                BorderThickness="0" Cursor="Hand" Click="SideToggle_Click"
                ToolTip="收起/展开侧栏（Tab）" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#FF272E37" BorderThickness="0,0,1,0">
                        <TextBlock x:Name="Txt" Text="◀" Foreground="#FF66727F" FontSize="9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF232B34"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- 左侧栏 -->
        <Border Grid.Column="0" Background="#FF191F26" BorderBrush="#FF272E37" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock Text="直播列表" DockPanel.Dock="Top" FontSize="17" FontWeight="Bold"
                           Foreground="#FF4FA3E3" Margin="14,14,12,10"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,12,10">
                    <Button Style="{StaticResource ToolBtn}" Content="添加源" Click="BtnAdd_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="刷新" Click="BtnRefresh_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="收藏" Click="BtnFav_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="小窗" Click="BtnPip_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="全屏" Click="BtnFull_Click"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                    <TextBox x:Name="SearchBox" Height="30" Background="#FF20262E" BorderBrush="#FF2D3540"
                             BorderThickness="1" Foreground="#FFDDE4EB" Padding="8,4" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                             ToolTip="Ctrl+F 聚焦搜索，Esc 清空，回车播放第一个结果"/>
                    <TextBlock Text="搜索频道 / 分组（Ctrl+F）" Style="{StaticResource SearchHint}"
                               Foreground="#FF66727F" FontSize="12" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <!-- 独立源管理面板：可展开/收起，显示所有源并点击切换 -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,8" Background="#FF20262E"
                        BorderBrush="#FF2D3540" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <Button x:Name="SrcToggleBtn" DockPanel.Dock="Right" Width="30" Height="30"
                                Content="▾" Foreground="#FFC7D1DA" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="SrcToggle_Click" ToolTip="展开/收起源列表"/>
                        <TextBlock Text="源列表" Foreground="#FF4FA3E3" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SrcPanel, Path=Visibility}" Value="Visible">
                                    <Setter Property="Padding" Value="0,0,0,6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel x:Name="SrcPanel" DockPanel.Dock="Top" Margin="12,0,12,8" Visibility="Collapsed">
                    <ListBox x:Name="SrcList" MaxHeight="160" Background="#FF20262E" BorderBrush="#FF2D3540"
                             BorderThickness="1" SelectionChanged="SrcList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="6,3">
                                    <TextBlock Text="●" Foreground="#FF4FA3E3" FontSize="10"
                                               VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="#FFE2E8EF" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="管理源…" Height="28" Margin="0,6,0,0" Background="#FF232B34"
                            Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand" FontSize="12"
                            Click="BtnAdd_Click"/>
                </StackPanel>

                <DockPanel DockPanel.Dock="Top" Margin="12,0,12,8">
                    <Button DockPanel.Dock="Right" Content="管理" Width="44" Height="30" Margin="6,0,0,0"
                            Background="#FF232B34" Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand"
                            FontSize="11" Click="BtnManageGroups_Click" ToolTip="分组管理"/>
                    <ComboBox x:Name="GroupCombo" Height="30" Background="#FF20262E" Foreground="#FFDDE4EB"
                              SelectionChanged="GroupCombo_SelectionChanged"/>
                </DockPanel>

                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Text="0 个频道"
                           Foreground="#FF66727F" FontSize="12" Margin="14,2,12,6"/>

                <ListBox x:Name="ChannelList" Margin="4,0,4,6" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.IsVirtualizing="True"
                         MouseDoubleClick="ChannelList_MouseDoubleClick">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="小窗播放" Click="MiPip_Click"/>
                            <MenuItem Header="新窗口播放" Click="MiNewWin_Click"/>
                            <MenuItem Header="收藏 / 取消收藏" Click="MiFavorite_Click"/>
                            <MenuItem Header="隐藏频道" Click="MiHide_Click"/>
                            <MenuItem Header="复制频道地址" Click="MiCopy_Click"/>
                            <Separator/>
                            <MenuItem Header="排序">
                                <MenuItem x:Name="SortByNumber" Header="按号码" IsCheckable="True" IsChecked="True"
                                          Click="SortByNumber_Click"/>
                                <MenuItem x:Name="SortByName" Header="按名称" IsCheckable="True"
                                          Click="SortByName_Click"/>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="8,2">
                                <TextBlock Text="{Binding Number}" Width="34" Foreground="#FF5E6B79" FontSize="12"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button Content="{Binding FavoriteMark}" Tag="{Binding}" Click="FavStar_Click"
                                        Width="22" Height="22" Background="Transparent" BorderThickness="0"
                                        Foreground="#FFD9A521" FontSize="14" Cursor="Hand" Focusable="False"
                                        ToolTip="点击收藏 / 取消收藏" DockPanel.Dock="Right" Margin="0,0,4,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Group}" Foreground="#FF4E5967" FontSize="11"
                                           VerticalAlignment="Center" MaxWidth="80" Margin="6,0,0,0"
                                           TextTrimming="CharacterEllipsis" DockPanel.Dock="Right" ToolTip="{Binding Group}"/>
                                <TextBlock Text="{Binding Name}" Foreground="#FFE2E8EF" FontSize="13"
                                           Margin="0,0,6,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 视频区 + 状态栏 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <lvc:VideoView x:Name="VideoView" Grid.Row="0" Grid.Column="0" Background="Black" Focusable="False"/>

            <!-- EPG 节目单面板 -->
            <Border x:Name="EpgPanel" Grid.Row="0" Grid.Column="1" Width="260" Background="#FF14181D"
                    BorderBrush="#FF272E37" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Text="节目单" DockPanel.Dock="Top" FontWeight="Bold" Foreground="#FF4FA3E3"
                               FontSize="13" Margin="12,10,12,6"/>
                    <TextBlock x:Name="EpgNow" DockPanel.Dock="Top" Foreground="#FFB9C4CE" FontSize="11"
                               Margin="12,0,12,8" TextWrapping="Wrap"/>
                    <ListBox x:Name="EpgList" Background="Transparent" BorderThickness="0" Margin="0,0,0,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,4">
                                    <TextBlock Text="{Binding TimeRange}" Foreground="#FF4FA3E3" FontSize="11"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#FFE2E8EF" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel x:Name="EmptyState" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="暂无频道" FontSize="18" Foreground="#FF8A97A5" HorizontalAlignment="Center"/>
                <TextBlock Text="添加 M3U / M3U8 播放列表后即可观看" FontSize="12" Foreground="#FF5E6B79"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <Button Content="添加播放列表" Style="{StaticResource ToolBtn}" FontSize="13" Padding="18,8"
                         Margin="0,16,0,0" HorizontalAlignment="Center" Click="BtnAdd_Click"/>
            </StackPanel>

            <!-- 全屏控制浮层：鼠标移动显示，静止自动隐藏 -->
            <Border x:Name="FullscreenOverlay" Grid.Row="0" Grid.ColumnSpan="2" Background="#66000000"
                    Visibility="Collapsed" VerticalAlignment="Bottom" Padding="0,10,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="FsNowPlaying" Text="" Foreground="#FFE8EDF2" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,20,0" MaxWidth="360"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="FsPlayPause" Content="⏸" Width="40" Height="36" Margin="4,0"
                            Background="#CC232B34" Foreground="#FFE8EDF2" BorderThickness="0" Cursor="Hand"
                            Click="BtnPlayPause_Click" ToolTip="播放/暂停（Space）"/>
                    <Button x:Name="FsStop" Content="⏹" Width="40" Height="36" Margin="4,0"
                            Background="#CC232B34" Foreground="#FFE8EDF2" BorderThickness="0" Cursor="Hand"
                            Click="BtnStop_Click" ToolTip="停止（S）"/>
                    <Button x:Name="FsExitFull" Content="退出全屏" Width="88" Height="36" Margin="4,0"
                            Background="#CC232B34" Foreground="#FFE8EDF2" BorderThickness="0" Cursor="Hand"
                            Click="BtnFull_Click" ToolTip="退出全屏（Esc / F11）"/>
                </StackPanel>
            </Border>

            <Border x:Name="StatusBar" Grid.Row="1" Grid.ColumnSpan="2" Background="#FF191F26" BorderBrush="#FF272E37"
                    BorderThickness="0,1,0,0" Padding="14,7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPlayPause" Content="⏸" Width="26" Height="24" Margin="4,0,0,0"
                                Background="#FF232B34" Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand"
                                Click="BtnPlayPause_Click" ToolTip="播放/暂停（Space）"/>
                        <Button x:Name="BtnStop" Content="⏹" Width="26" Height="24" Margin="4,0,0,0"
                                Background="#FF232B34" Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand"
                                Click="BtnStop_Click" ToolTip="停止（S）"/>
                        <Button x:Name="BtnSettings" Content="⚙" Width="26" Height="24" Margin="4,0,0,0"
                                Background="#FF232B34" Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand"
                                Click="BtnSettings_Click" ToolTip="设置"/>
                        <TextBlock x:Name="VolumeText" Text="音量 80%" Foreground="#FF7A8896" FontSize="12"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlayState" Text="就绪" Foreground="#FF7A8896" FontSize="12"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="NowPlaying" Text="未播放" Foreground="#FFB9C4CE" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               DockPanel.Dock="Left" MaxWidth="280"/>
                    <Grid VerticalAlignment="Center" Margin="14,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeText" Text="00:00" Foreground="#FF7A8896" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                Style="{StaticResource DarkSlider}"
                                ValueChanged="SeekBar_ValueChanged"
                                PreviewMouseDown="SeekBar_PreviewMouseDown"
                                PreviewMouseUp="SeekBar_PreviewMouseUp"/>
                        <TextBlock x:Name="DurationText" Text="--:--" Grid.Column="2" Foreground="#FF7A8896"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
