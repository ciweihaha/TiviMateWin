<Window x:Class="TiviMateWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="星辰直播" Height="640" Width="1120" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF12161B" Foreground="#FFE8EDF2"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseMove="Window_PreviewMouseMove">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF232B34"/>
            <Setter Property="Foreground" Value="#FFC7D1DA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF31404F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F4E7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFE2E8EF"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF232B34"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F4E7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchHint" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideCol" Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧栏 -->
        <Border Grid.Column="0" Background="#FF191F26" BorderBrush="#FF272E37" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock Text="星辰直播" DockPanel.Dock="Top" FontSize="17" FontWeight="Bold"
                           Foreground="#FF4FA3E3" Margin="14,14,12,10"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,12,10">
                    <Button Style="{StaticResource ToolBtn}" Content="添加源" Click="BtnAdd_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="刷新" Click="BtnRefresh_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="收藏" Click="BtnFav_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="全屏" Click="BtnFull_Click"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                    <TextBox x:Name="SearchBox" Height="30" Background="#FF20262E" BorderBrush="#FF2D3540"
                             BorderThickness="1" Foreground="#FFDDE4EB" Padding="8,4" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                             ToolTip="Ctrl+F 聚焦搜索，Esc 清空，回车播放第一个结果"/>
                    <TextBlock Text="搜索频道 / 分组（Ctrl+F）" Style="{StaticResource SearchHint}"
                               Foreground="#FF66727F" FontSize="12" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <ComboBox x:Name="PlaylistCombo" DockPanel.Dock="Top" Margin="12,0,12,8" Height="30"
                          Background="#FF20262E" Foreground="#FFDDE4EB" BorderBrush="#FF2D3540"
                          ToolTip="切换源（播放列表）" SelectionChanged="PlaylistCombo_SelectionChanged"/>

                <ComboBox x:Name="GroupCombo" DockPanel.Dock="Top" Margin="12,0,12,8" Height="30"
                          Background="#FF20262E" Foreground="#FFDDE4EB"
                          SelectionChanged="GroupCombo_SelectionChanged"/>

                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Text="0 个频道"
                           Foreground="#FF66727F" FontSize="12" Margin="14,2,12,6"/>

                <ListBox x:Name="ChannelList" Margin="4,0,4,6" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.IsVirtualizing="True"
                         MouseDoubleClick="ChannelList_MouseDoubleClick">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="收藏 / 取消收藏" Click="MiFavorite_Click"/>
                            <MenuItem Header="复制频道地址" Click="MiCopy_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="8,2">
                                <TextBlock Text="{Binding Number}" Width="34" Foreground="#FF5E6B79" FontSize="12"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding FavoriteMark}" Foreground="#FFD9A521" FontSize="12"
                                           Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                <TextBlock Text="{Binding Group}" Foreground="#FF4E5967" FontSize="11"
                                           VerticalAlignment="Center" MaxWidth="90" TextTrimming="CharacterEllipsis"
                                           DockPanel.Dock="Right" ToolTip="{Binding Group}"/>
                                <TextBlock Text="{Binding Name}" Foreground="#FFE2E8EF" FontSize="13"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 视频区 + 状态栏 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <lvc:VideoView x:Name="VideoView" Grid.Row="0" Background="Black" Focusable="False"/>

            <StackPanel x:Name="EmptyState" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="暂无频道" FontSize="18" Foreground="#FF8A97A5" HorizontalAlignment="Center"/>
                <TextBlock Text="添加 M3U / M3U8 播放列表后即可观看" FontSize="12" Foreground="#FF5E6B79"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <Button Content="添加播放列表" Style="{StaticResource ToolBtn}" FontSize="13" Padding="18,8"
                         Margin="0,16,0,0" HorizontalAlignment="Center" Click="BtnAdd_Click"/>
            </StackPanel>

            <Border x:Name="StatusBar" Grid.Row="1" Background="#FF191F26" BorderBrush="#FF272E37"
                    BorderThickness="0,1,0,0" Padding="14,7">
                <DockPanel>
                    <TextBlock x:Name="VolumeText" Text="音量 80%" DockPanel.Dock="Right" Foreground="#FF7A8896"
                               FontSize="12" Margin="14,0,0,0"/>
                    <TextBlock x:Name="PlayState" Text="就绪" DockPanel.Dock="Right" Foreground="#FF7A8896" FontSize="12"/>
                    <TextBlock x:Name="NowPlaying" Text="未播放" Foreground="#FFB9C4CE" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
