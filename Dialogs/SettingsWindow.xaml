<Window x:Class="TiviMateWin.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" Height="520" WindowStartupLocation="CenterOwner"
        Background="#FF191F26" Foreground="#FFE8EDF2" FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="播放器设置" FontSize="16" FontWeight="Bold" Foreground="#FF4FA3E3" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 版本与更新（v1.4.35）：当前版本一眼能看到；检查更新去 GitHub 查最新 release，
                     有新版点一下就能下载（走国内镜像，不走打不开的直链）。 -->
                <TextBlock Text="版本" FontSize="14" FontWeight="Bold" Foreground="#FF4FA3E3" Margin="0,4,0,4"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="当前版本 ?" Foreground="#FFB9C4CE" FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CheckUpdateBtn" Content="检查更新" Height="28" Padding="12,0" Margin="12,0,0,0"
                            Background="#FF232B34" Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand"
                            Click="CheckUpdate_Click"/>
                    <Button x:Name="DownloadUpdateBtn" Content="下载新版本" Height="28" Padding="12,0" Margin="8,0,0,0"
                            Background="#FF4FA3E3" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="DownloadUpdate_Click" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="UpdateResultText" Text="" Foreground="#FF7A8896" FontSize="11" Margin="0,6,0,12"
                           TextWrapping="Wrap"/>

                <!-- 网络缓存 -->
                <TextBlock Text="网络缓存（毫秒）" Foreground="#FFB9C4CE" FontSize="12" Margin="0,4,0,4"/>
                <Slider x:Name="CacheSlider" Minimum="200" Maximum="10000" TickFrequency="100"
                        ValueChanged="CacheSlider_ValueChanged"/>
                <TextBlock x:Name="CacheValue" Text="800 ms" Foreground="#FF7A8896" FontSize="11" Margin="0,2,0,12"/>

                <!-- 硬件解码 -->
                <CheckBox x:Name="HwDecodeChk" Content="硬件解码（Intel 核显加速）" Foreground="#FFB9C4CE"
                          FontSize="12" Margin="0,4,0,2" Checked="HwDecode_Changed" Unchecked="HwDecode_Changed"/>
                <TextBlock x:Name="HwDecodeHint" Text="⚠ 改动将在重启应用后生效" Foreground="#FFE8B93E" FontSize="11"
                           Margin="0,0,0,12" Visibility="Collapsed"/>

                <!-- 画面比例 -->
                <TextBlock Text="画面比例" Foreground="#FFB9C4CE" FontSize="12" Margin="0,4,0,4"/>
                <ComboBox x:Name="AspectCombo" Height="30" Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="Aspect_Changed">
                    <ComboBoxItem Content="原始"/>
                    <ComboBoxItem Content="16:9"/>
                    <ComboBoxItem Content="4:3"/>
                    <ComboBoxItem Content="拉伸"/>
                </ComboBox>

                <!-- 倍速 -->
                <TextBlock Text="播放倍速（Ctrl+[ / Ctrl+] 调整）" Foreground="#FFB9C4CE" FontSize="12"
                           Margin="0,16,0,4"/>
                <ComboBox x:Name="RateCombo" Height="30" Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="Rate_Changed">
                    <ComboBoxItem Content="0.5x"/>
                    <ComboBoxItem Content="0.75x"/>
                    <ComboBoxItem Content="1.0x"/>
                    <ComboBoxItem Content="1.25x"/>
                    <ComboBoxItem Content="1.5x"/>
                    <ComboBoxItem Content="2.0x"/>
                </ComboBox>

                <!-- 主题 -->
                <TextBlock Text="主题" Foreground="#FFB9C4CE" FontSize="12" Margin="0,16,0,4"/>
                <ComboBox x:Name="ThemeCombo" Height="30" Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="Theme_Changed">
                    <ComboBoxItem Content="深色"/>
                    <ComboBoxItem Content="浅色"/>
                </ComboBox>

                <!-- 直播实时字幕（听写+翻译） -->
                <TextBlock Text="直播实时字幕" FontSize="14" FontWeight="Bold" Foreground="#FF4FA3E3"
                           Margin="0,20,0,4"/>
                <CheckBox x:Name="LiveSubtitleChk" Content="播直播时实时出中文字幕（先听写成英文、再用免费接口翻译）"
                          Foreground="#FFB9C4CE" FontSize="12" Margin="0,4,0,2"/>
                <CheckBox x:Name="LiveSubtitleEnglishChk" Content="字幕条同时显示英文原文" Foreground="#FFB9C4CE"
                          FontSize="12" Margin="0,4,0,2"/>
                <CheckBox x:Name="LiveSubtitleSerialChk" Content="串行模式（听写与翻译依次跑；不勾为两级流水线并行）" Foreground="#FFB9C4CE"
                          FontSize="12" Margin="0,4,0,2"/>
                <!-- 翻译范围（v1.4.33）：只翻英语——听写模型是 tiny.en，本来也只认英语；
                     法语/德语/日语等不翻译。默认"仅英语台"。 -->
                <TextBlock Text="翻译范围（只翻英语台才有意义）" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <ComboBox x:Name="LiveSubtitleModeCombo" Height="30" Style="{StaticResource DarkComboBoxStyle}">
                    <ComboBoxItem Content="关闭"/>
                    <ComboBoxItem Content="仅英语台"/>
                    <ComboBoxItem Content="全部台"/>
                </ComboBox>
                <!-- 翻译服务商（v1.4.33 重构）：只走免费接口，本地大模型已删掉。
                     微软 Azure 每月 200 万字符免费（最划算）、
                     Cloudflare 每天 1 万 neurons 免费。Key 去各家免费开、贴进来，不收费。 -->
                <TextBlock Text="翻译服务商（免费接口）" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <ComboBox x:Name="LiveSubtitleProviderCombo" Height="30" Style="{StaticResource DarkComboBoxStyle}">
                    <ComboBoxItem Content="微软 Azure（免费）"/>
                    <ComboBoxItem Content="Cloudflare（免费）"/>
                </ComboBox>
                <TextBlock Text="免费接口 Key（Azure 用；存在本机加密配置里）" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <PasswordBox x:Name="FreeApiKeyBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                             BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="Azure 区域（可选，如 eastasia；不填不发区域头）" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <TextBox x:Name="AzureRegionBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                         BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="Cloudflare 账号 ID（Cloudflare 服务商用）" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <TextBox x:Name="CloudflareAccountIdBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                         BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="Cloudflare API 令牌（Cloudflare 服务商用，需 Workers AI 权限；存在本机加密配置里）" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <PasswordBox x:Name="CloudflareApiTokenBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                             BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="接口失败跳过该行（显示英文原文），不回落本地；字幕比说话慢几秒（听写+翻译需要时间）；首次开启要下载语音模型（约 148MB），下载进度会显示在字幕条上" Foreground="#FF7A8896" FontSize="11" Margin="0,6,0,0"/>

                <!-- Xtream Codes -->
                <TextBlock Text="Xtream Codes 接入（可选）" FontSize="14" FontWeight="Bold" Foreground="#FF4FA3E3"
                           Margin="0,20,0,4"/>
                <TextBlock Text="服务器地址（如 http://host:port）" Foreground="#FFB9C4CE" FontSize="11" Margin="0,2,0,2"/>
                <TextBox x:Name="XtreamServerBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                         BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="用户名" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <TextBox x:Name="XtreamUserBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                         BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="密码" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <PasswordBox x:Name="XtreamPassBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                             BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="保存后自动加载 Xtream 频道列表" Foreground="#FF7A8896" FontSize="11" Margin="0,6,0,0"/>

                <!-- OpenList 网盘 -->
                <TextBlock Text="OpenList 网盘（可选）" FontSize="14" FontWeight="Bold" Foreground="#FF4FA3E3"
                           Margin="0,20,0,4"/>
                <TextBlock Text="服务器地址（如 https://openlist.example.com）" Foreground="#FFB9C4CE" FontSize="11" Margin="0,2,0,2"/>
                <TextBox x:Name="OpenListServerBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                         BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="用户名" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <TextBox x:Name="OpenListUserBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                         BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="密码" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <PasswordBox x:Name="OpenListPassBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                             BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="用于“网盘”浏览播放网盘里的视频；密码 DPAPI 加密存储" Foreground="#FF7A8896" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Height="32" Background="#FF232B34" Foreground="#FFC7D1DA"
                    BorderThickness="0" Cursor="Hand" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="保存" Width="80" Height="32" Background="#FF4FA3E3" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
