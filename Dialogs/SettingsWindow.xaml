<Window x:Class="TiviMateWin.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" Height="520" WindowStartupLocation="CenterOwner"
        Background="#FF191F26" Foreground="#FFE8EDF2" FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="播放器设置" FontSize="16" FontWeight="Bold" Foreground="#FF4FA3E3" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 网络缓存 -->
                <TextBlock Text="网络缓存（毫秒）" Foreground="#FFB9C4CE" FontSize="12" Margin="0,4,0,4"/>
                <Slider x:Name="CacheSlider" Minimum="200" Maximum="5000" TickFrequency="100"
                        ValueChanged="CacheSlider_ValueChanged"/>
                <TextBlock x:Name="CacheValue" Text="800 ms" Foreground="#FF7A8896" FontSize="11" Margin="0,2,0,12"/>

                <!-- 硬件解码 -->
                <CheckBox x:Name="HwDecodeChk" Content="硬件解码（Intel 核显加速）" Foreground="#FFB9C4CE"
                          FontSize="12" Margin="0,4,0,12" Checked="HwDecode_Changed" Unchecked="HwDecode_Changed"/>

                <!-- 画面比例 -->
                <TextBlock Text="画面比例" Foreground="#FFB9C4CE" FontSize="12" Margin="0,4,0,4"/>
                <ComboBox x:Name="AspectCombo" Height="30" Background="#FF20262E" Foreground="#FFDDE4EB"
                          SelectionChanged="Aspect_Changed">
                    <ComboBoxItem Content="原始"/>
                    <ComboBoxItem Content="16:9"/>
                    <ComboBoxItem Content="4:3"/>
                    <ComboBoxItem Content="拉伸"/>
                </ComboBox>

                <!-- 倍速 -->
                <TextBlock Text="播放倍速（Ctrl+[ / Ctrl+] 调整）" Foreground="#FFB9C4CE" FontSize="12"
                           Margin="0,16,0,4"/>
                <ComboBox x:Name="RateCombo" Height="30" Background="#FF20262E" Foreground="#FFDDE4EB"
                          SelectionChanged="Rate_Changed">
                    <ComboBoxItem Content="0.5x"/>
                    <ComboBoxItem Content="0.75x"/>
                    <ComboBoxItem Content="1.0x"/>
                    <ComboBoxItem Content="1.25x"/>
                    <ComboBoxItem Content="1.5x"/>
                    <ComboBoxItem Content="2.0x"/>
                </ComboBox>

                <!-- 主题 -->
                <TextBlock Text="主题" Foreground="#FFB9C4CE" FontSize="12" Margin="0,16,0,4"/>
                <ComboBox x:Name="ThemeCombo" Height="30" Background="#FF20262E" Foreground="#FFDDE4EB"
                          SelectionChanged="Theme_Changed">
                    <ComboBoxItem Content="深色"/>
                    <ComboBoxItem Content="浅色"/>
                </ComboBox>

                <!-- Xtream Codes -->
                <TextBlock Text="Xtream Codes 接入（可选）" FontSize="14" FontWeight="Bold" Foreground="#FF4FA3E3"
                           Margin="0,20,0,4"/>
                <TextBlock Text="服务器地址（如 http://host:port）" Foreground="#FFB9C4CE" FontSize="11" Margin="0,2,0,2"/>
                <TextBox x:Name="XtreamServerBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                         BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="用户名" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <TextBox x:Name="XtreamUserBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                         BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="密码" Foreground="#FFB9C4CE" FontSize="11" Margin="0,8,0,2"/>
                <PasswordBox x:Name="XtreamPassBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                             BorderBrush="#FF2D3540" Padding="6,3"/>
                <TextBlock Text="保存后自动加载 Xtream 频道列表" Foreground="#FF7A8896" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Height="32" Background="#FF232B34" Foreground="#FFC7D1DA"
                    BorderThickness="0" Cursor="Hand" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="保存" Width="80" Height="32" Background="#FF4FA3E3" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
