<Window x:Class="TiviMateWin.Dialogs.PlayUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="点播链接" Width="520" Height="340" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#FF171C22" Foreground="#FFDDE4EB">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="视频链接（m3u8 / mp4 / mkv 等直链，也可填本地视频文件路径）"
                   Foreground="#FFB9C4CE" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="UrlBox" Grid.Row="1" Height="30" Background="#FF20262E" Foreground="#FFDDE4EB"
                 BorderBrush="#FF3A444F" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center"
                 TextChanged="UrlBox_TextChanged"/>

        <TextBlock Text="名称（可空，默认取链接文件名）" Grid.Row="2"
                   Foreground="#FFB9C4CE" FontSize="12" Margin="0,10,0,4"/>
        <TextBox x:Name="NameBox" Grid.Row="3" Height="30" Background="#FF20262E" Foreground="#FFDDE4EB"
                 BorderBrush="#FF3A444F" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center"/>

        <ListBox x:Name="RecentList" Grid.Row="4" Background="Transparent" BorderThickness="0"
                 Margin="0,10,0,0" SelectionChanged="RecentList_SelectionChanged"
                 ToolTip="最近播放的点播链接，点一下填入上方">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#FF7A8896" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="导入点播源…" Width="100" Height="30" Margin="0,0,8,0"
                    Background="#FF1F4E7A" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="Import_Click" ToolTip="导入 vod.json 点播源，选片播放"/>
            <Button Content="小窗播放" Width="84" Height="30" Margin="0,0,8,0"
                    Background="#FF2A3542" Foreground="#FFDDE4EB" BorderThickness="0" Cursor="Hand"
                    Click="Pip_Click"/>
            <Button Content="主窗口播放" Width="100" Height="30" Margin="0,0,8,0" IsDefault="True"
                    Background="#FF1F6F4A" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="Play_Click"/>
            <Button Content="取消" Width="64" Height="30"
                    Background="#FF2A3542" Foreground="#FFDDE4EB" BorderThickness="0" Cursor="Hand"
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
