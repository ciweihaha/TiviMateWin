<Window x:Class="TiviMateWin.Dialogs.GroupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分组管理" Width="360" Height="420" WindowStartupLocation="CenterOwner"
        Background="#FF191F26" Foreground="#FFE8EDF2" FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="选择分组" FontSize="14" FontWeight="Bold" Foreground="#FF4FA3E3" Margin="0,0,0,8"/>
        <ListBox x:Name="GroupList" Grid.Row="1" Background="#FF20262E" BorderBrush="#FF2D3540"
                 BorderThickness="1" SelectionChanged="GroupList_SelectionChanged"/>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="新名称（重命名/新建）" Foreground="#FFB9C4CE" FontSize="11"/>
            <TextBox x:Name="NewNameBox" Height="28" Margin="0,4,0,0" Background="#FF20262E"
                     Foreground="#FFDDE4EB" BorderBrush="#FF2D3540" Padding="6,3"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="新建分组" Width="80" Height="32" Margin="0,0,8,0" Background="#FF232B34"
                    Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand" Click="New_Click"/>
            <Button Content="重命名" Width="80" Height="32" Margin="0,0,8,0" Background="#FF232B34"
                    Foreground="#FFC7D1DA" BorderThickness="0" Cursor="Hand" Click="Rename_Click"/>
            <Button Content="删除分组" Width="80" Height="32" Margin="0,0,8,0" Background="#FF8A3B3B"
                    Foreground="White" BorderThickness="0" Cursor="Hand" Click="Delete_Click"/>
            <Button Content="取消" Width="80" Height="32" Background="#FF232B34" Foreground="#FFC7D1DA"
                    BorderThickness="0" Cursor="Hand" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>