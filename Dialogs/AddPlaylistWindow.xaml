<Window x:Class="TiviMateWin.Dialogs.AddPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理播放列表" Width="680" MaxWidth="680" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#FF191F26" Foreground="#FFE8EDF2" FontFamily="Microsoft YaHei UI">
    <StackPanel Margin="18">

        <TextBlock Text="添加新源" Foreground="#FF4FA3E3" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
        <TextBlock Text="名称（可选，用于识别列表）" Foreground="#FF8A97A5" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Height="32" Background="#FF20262E" BorderBrush="#FF2D3540"
                 Foreground="#FFDDE4EB" Padding="8,4" VerticalContentAlignment="Center"/>

        <TextBlock Text="M3U / M3U8 地址（http 或本地文件路径）" Foreground="#FF8A97A5" FontSize="12" Margin="0,12,0,4"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="浏览…" Width="76" Height="32" Margin="8,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="UrlBox" Height="32" Background="#FF20262E" BorderBrush="#FF2D3540"
                     Foreground="#FFDDE4EB" Padding="8,4" VerticalContentAlignment="Center"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Height="32" IsCancel="True"/>
            <Button Content="导入" Width="80" Height="32" Margin="10,0,0,0" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>

        <Separator Margin="0,18,0,10" Background="#FF272E37"/>
        <TextBlock x:Name="CountText" Text="已有播放列表" Foreground="#FF4FA3E3" FontWeight="Bold"
                   FontSize="13" Margin="0,0,0,8"/>
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListPanel"/>
        </ScrollViewer>
    </StackPanel>
</Window>
