<Window x:Class="TiviMateWin.Dialogs.VodBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="点播源" Width="760" Height="520" WindowStartupLocation="CenterOwner"
        Background="#FF171C22" Foreground="#FFDDE4EB" Closed="Window_Closed">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- vod.json 地址 -->
        <DockPanel Grid.Row="0">
            <Button Content="浏览文件" Width="76" Height="30" DockPanel.Dock="Right" Margin="6,0,0,0"
                    Background="#FF2A3542" Foreground="#FFDDE4EB" BorderThickness="0" Cursor="Hand"
                    Click="Browse_Click"/>
            <Button Content="加载" Width="60" Height="30" DockPanel.Dock="Right" Margin="6,0,0,0"
                    Background="#FF1F6F4A" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="Load_Click"/>
            <TextBox x:Name="SourceBox" Height="30" Background="#FF20262E" Foreground="#FFDDE4EB"
                     BorderBrush="#FF3A444F" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center"
                     Text="https://live.ciweihaha.win/vod.json"
                     ToolTip="vod.json 地址（http(s) 链接）或本地文件路径"/>
        </DockPanel>

        <!-- 搜索 + 翻页 -->
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <Button x:Name="PrevBtn" Content="◀ 上页" Width="64" Height="28" DockPanel.Dock="Right" Margin="6,0,0,0"
                    Background="#FF2A3542" Foreground="#FFDDE4EB" BorderThickness="0" Cursor="Hand"
                    Click="Prev_Click" IsEnabled="False"/>
            <Button x:Name="NextBtn" Content="下页 ▶" Width="64" Height="28" DockPanel.Dock="Right"
                    Background="#FF2A3542" Foreground="#FFDDE4EB" BorderThickness="0" Cursor="Hand"
                    Click="Next_Click" IsEnabled="False"/>
            <TextBlock x:Name="PageText" DockPanel.Dock="Right" Foreground="#FF7A8896" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="搜索" Width="60" Height="28" DockPanel.Dock="Right" Margin="6,0,8,0"
                    Background="#FF1F4E7A" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="Search_Click"/>
            <TextBox x:Name="SearchBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                     BorderBrush="#FF3A444F" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center"
                     KeyDown="SearchBox_KeyDown" ToolTip="在当前站点搜索影片，回车搜索"/>
        </DockPanel>

        <!-- 站点 + 影片 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="SiteList" Background="#FF20262E" BorderBrush="#FF3A444F" BorderThickness="1"
                     SelectionChanged="SiteList_SelectionChanged" ToolTip="点播站（灰色为不支持的 XML 站）">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" FontSize="12"
                                   Padding="4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox x:Name="VideoList" Grid.Column="1" Margin="8,0,0,0" Background="#FF20262E"
                     BorderBrush="#FF3A444F" BorderThickness="1"
                     SelectionChanged="VideoList_SelectionChanged"
                     MouseDoubleClick="VideoList_DoubleClick" ToolTip="双击播放">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4">
                            <TextBlock Text="{Binding Remarks}" DockPanel.Dock="Right" Foreground="#FF7A8896"
                                       FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" Foreground="#FFDDE4EB" FontSize="13"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 线路/选集：选一部影片后显示全部线路×剧集，自动选中首条可用线路 -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="线路/选集：" VerticalAlignment="Center" Foreground="#FF7A8896" FontSize="12" DockPanel.Dock="Left"/>
            <TextBlock x:Name="CandidateHint" DockPanel.Dock="Right" Foreground="#FF7A8896" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0,0,0" Text="选一部影片后显示可选线路与剧集"/>
            <ComboBox x:Name="CandidateBox" Height="28" Background="#FF20262E" Foreground="#FFDDE4EB"
                      BorderBrush="#FF3A444F" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center"
                      IsEnabled="False"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#FF7A8896" FontSize="11"
                   Margin="0,8,0,0" Text="已预填影视 App 点播地址，正在加载…" TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="PipBtn" Content="小窗播放" Width="84" Height="30" Margin="0,0,8,0"
                    Background="#FF2A3542" Foreground="#FFDDE4EB" BorderThickness="0" Cursor="Hand"
                    Click="Pip_Click" IsEnabled="False"/>
            <Button x:Name="PlayBtn" Content="播放" Width="84" Height="30" Margin="0,0,8,0" IsDefault="True"
                    Background="#FF1F6F4A" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="Play_Click" IsEnabled="False"/>
            <Button Content="关闭" Width="64" Height="30"
                    Background="#FF2A3542" Foreground="#FFDDE4EB" BorderThickness="0" Cursor="Hand"
                    Click="Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
